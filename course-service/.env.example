# Copier en .env (ignore par git) et renseigner la cle Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=votre_cle_ici
# Optionnel
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Meme valeur que jwt.secret du user-service
JWT_SECRET=votre_secret_jwt_ici
# Optionnel : cle dediee au generateur de quiz (quota separe)
GEMINI_QUIZ_API_KEY=votre_cle_quiz_ici
