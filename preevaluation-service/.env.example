# Configuration Groq API pour le preevaluation-service
# 
# OPTION 1 (Recommandée) : Variables d'environnement système Windows
#   - Plus sécurisé (pas de fichier avec secrets)
#   - Définir dans : Paramètres système → Variables d'environnement
#   - Variables à créer : GROQ_API_KEY, GROQ_MODEL, GROQ_EMBEDDING_MODEL
#
# OPTION 2 : Fichier .env (si vous ne travaillez PAS avec des AI assistants)
#   - Copier ce fichier en .env
#   - Remplir avec vos vraies valeurs
#   - ⚠️ NE JAMAIS ouvrir .env dans un éditeur avec AI (Kiro, Cursor, Copilot)

# Clé API Groq (OBLIGATOIRE)
# Obtenir votre clé sur : https://console.groq.com/keys
GROQ_API_KEY=gsk_votre_cle_ici

# Modèle de chat Groq (RECOMMANDÉ)
# Valeur par défaut : openai/gpt-oss-20b
# Modèles disponibles en octobre 2026 :
#   - openai/gpt-oss-20b (rapide, économique, recommandé)
#   - openai/gpt-oss-120b (plus puissant, plus cher)
#   - llama-3.1-8b-instant (Enterprise uniquement)
#   - llama-3.3-70b-versatile (Enterprise uniquement)
GROQ_MODEL=openai/gpt-oss-20b

# Modèle d'embeddings Groq (OPTIONNEL)
# Valeur par défaut : nomic-embed-text-v1_5
# Si non disponible, le système utilisera un encodage local (hash TF)
GROQ_EMBEDDING_MODEL=nomic-embed-text-v1_5

# Configuration Base de données MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/preevaluation_db?useSSL=false&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
