# Copy this file to .env (never commit .env) and fill in your own keys.
# start_all.ps1 and docker compose both read it.

# ---- Shared ----
# Signs/validates login tokens in user, course, job and preevaluation services. Use a long random value in production.
JWT_SECRET=learnifySecretKeyUltraLongueEtTresSecurisee!

# ---- Gemini (ai-service chatbot, course-service "Ask the course" + lesson quiz, event-service RAG) ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: separate key for the lesson quiz generator (separate quota)
GEMINI_QUIZ_API_KEY=

# ---- Groq (preevaluation-service RAG, job-service AI ranking / code audit) ----
# https://console.groq.com/keys
GROQ_API_KEY=

# ---- Ollama (job-service RAG chat, runs locally) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ---- Optional job-service tools ----
TESSERACT_PATH=tesseract
# Absolute path to job-service/whisper_transcribe.py if not started from the repo
WHISPER_SCRIPT_PATH=

# ---- user-service (email + Google login) ----
SENDGRID_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- payment-service (Gmail SMTP for payment emails, use an App Password) ----
EMAIL_USERNAME=
EMAIL_PASSWORD=
